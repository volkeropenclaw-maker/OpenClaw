# FridgeChef Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for AI recipe generation and photo analysis)
OPENAI_API_KEY=sk-...

# Spoonacular API Key (optional, for recipe search with nutrition data)
SPOONACULAR_API_KEY=your_spoonacular_key_here

# Database path (optional, defaults to fridgechef.db in app directory)
DATABASE_URL=sqlite:///fridgechef.db

# App secret (for any signing needs)
SECRET_KEY=your-secret-key-here
OPENAI_API_KEY=sk-test
SPOONACULAR_API_KEY=test
